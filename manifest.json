{
    "manifest_version": 3,
    "name": "drrr chatbot extension",
    "description": "chatbot extension for drrr.com",
    "short_name": "drrrbot",
    "version": "1.843",
    "default_locale": "en",
    "current_locale": "zh",
    "background": {
        "service_worker": "background_wrapper.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://drrr.com/room/*"
            ],
            "css": [
                "/content/index.css"
            ],
            "run_at": "document_start",
            "js": [
                "/js/jquery-3.4.1.min.js",
                "/js/jquery.textcomplete.min.js",
                "/js/data.min.js",
                "/js/data.cn2t.min.js",
                "/js/data.t2cn.min.js",
                "/js/bundle-browser.min.js",
                "/lib/globals.js",
                "/lib/format.js",
                "/content/ui.js",
                "/content/methods.js",
                "/content/room.js"
            ]
        },
        {
            "matches": [
                "https://drrr.com/lounge/*"
            ],
            "run_at": "document_start",
            "css": [
                "/css/bootstrap.min.css"
            ],
            "js": [
                "/js/jquery-3.4.1.min.js",
                "/js/bootstrap.min.js",
                "/lib/globals.js",
                "/lib/format.js",
                "/content/lounge.js"
            ]
        },
        {
            "matches": [
                "https://drrr.com/"
            ],
            "run_at": "document_start",
            "js": [
                "/js/jquery-3.4.1.min.js",
                "/lib/globals.js",
                "/lib/format.js",
                "/content/index.js"
            ]
        },
        {
            "matches": [
                "https://chat.openai.com/chat"
            ],
            "js": [
                "/js/jquery-3.4.1.min.js",
                "/lib/globals.js",
                "/lib/format.js",
                "/content/chatGPT.js"
            ]
        }
    ],
    "permissions": [
        "tabs",
        "storage",
        "cookies",
        "notifications",
        "offscreen"
    ],
    "optional_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "images/*.png",
                "live2d-widget/*",
                "fonts/*",
                "setting/*.mjs"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
    },
    "incognito": "split",
    "action": {
        "default_icon": "icon.png",
        "default_popup": "/popup/index.html"
    },
    "host_permissions": [
        "*://drrr.com/*",
        "*://tinyurl.com/*",
        "*://keeper-cat.fly.dev/*",
        "*://link.hhtjim.com/*",
        "http://music.163.com/*",
        "https://store.line.me/*",
        "https://api.telegram.org/*",
        "https://api.tenor.com/*",
        "http://api.giphy.com/*",
        "https://github.com/*",
        "https://gitee.com/*",
        "https://script.google.com/*",
        "https://music.liuzhijin.cn/*",
        "https://*/*"
    ]
}